#include <bits/stdc++.h>
using namespace std;

using ll = long long;

int mergee(int a[], int l, int m, int r){
    int dem = 0;
    vector<int> x(a + l, a + m+1);
    vector<int> y(a+m+1, a+r+1);
    int i = 0, j = 0, index = l;
    while(i < x.size() && j < y.size()){
        if(x[i] <= y[j]){
            a[index] = x[i]; index++; i++;
        }
        else{
            dem += x.size() - i;
            a[index] = y[j]; index++; j++;
        }
    }
    while(i < x.size()){
        a[index] = x[i];
        index++; i++;
    }
    while(j < y.size()){
        a[index] = y[j];
        index++; j++;
    }
    return dem;
}

ll mergesort(int a[], int l, int r){
    ll cnt = 0;
    if(l < r){
        int mid = (l+r)/2;
        cnt += mergesort(a, l, mid);
        cnt += mergesort(a, mid + 1, r);
        cnt += mergee(a, l , mid, r);
    }
    return cnt;
}

int main(){

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n; cin >> n;
    int a[n];
    for(int i = 0; i < n; i++){
        cin >> a[i];
    }
    cout << mergesort(a, 0, n-1);


    return 0;
}
