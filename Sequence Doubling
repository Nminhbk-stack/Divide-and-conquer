#include <bits/stdc++.h>
using namespace std;
using ll = long long;

ll f[100];

ll position(ll n, ll k){
    if( n == 1) return 1;
    else if(k < f[n-1]) return position(n-1, k);
    else if( k == f[n-1] + 1) return n;
    else return position(n-1, k - f[n-1] - 1);
}

int main(){

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    ll n, k; cin >> n >> k;
    f[1] = 1;
    for(int i = 2; i <= n; i++){
        f[i] = 2*f[i-1] + 1;
    }
    cout << position(n, k);


    return 0;
}
