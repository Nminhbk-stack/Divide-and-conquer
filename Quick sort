#include <bits/stdc++.h>
using namespace std;

using ll = long long;

int partitionn(int a[], int l, int r){
    int i = l;
    for(int j = l; j <= r-1; j++){
        if(a[j] <= a[r]){
            swap(a[j], a[i]); i++;
        }
    }
    swap(a[r], a[i]);
    return i;
}

void quicksort(int a[], int l, int r){
    if(l < r){
        int p = partitionn(a, l, r);
        quicksort(a, l, p-1);
        quicksort(a, p+1, r);
    }
}



int main(){

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n; cin >> n;
    int a[n];
    for(int i = 0; i<n; i++){
        cin >> a[i];
    }
    quicksort(a, 0, n-1);
    for(int i = 0; i<n; i++){
        cout << a[i] << " ";
    }


    return 0;
}
