#include <bits/stdc++.h>
using namespace std;
using ll = long long;
ll f[10007];

char Find(ll k, ll n){
    if(n == 0){
        if(k == 1) return 'g';
        else return 'o';
    }
    if(k <= f[n-1]) return Find(k, n-1);
    else if(k > f[n-1] && k <= f[n-1] + (n+3)){
        if(k == f[n-1] + 1) return 'g';
        else return 'o';
    }
    else return Find(k - f[n-1] - n - 3, n-1);
}

int main(){

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);


    f[0] = 3;
    for(int i = 1; i<= 60; i++){
        f[i] = 2*f[i-1] + (i + 3);
    }
    int t; cin >> t;
    while(t--){
        ll k; cin >> k;
        cout << Find(k, 60) << endl;
    }

    return 0;
}
