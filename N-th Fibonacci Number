#include <bits/stdc++.h>
using namespace std;
using ll = long long;

ll MOD = 1e9 + 7;

struct Matrix{
   ll a[2][2];
};

Matrix multiply(Matrix x, Matrix y){
    Matrix res;
    for(int i = 0; i < 2; i++){
        for(int j = 0; j< 2; j++){
            res.a[i][j] = 0;
            for(int k = 0; k < 2; k++){
                res.a[i][j] += (x.a[i][k] % MOD) * (y.a[k][j] % MOD);
                res.a[i][j] %= MOD;
            }
        }
    }
    return res;
}

Matrix Power(Matrix x, ll n){
    if(n == 1) return x;
    Matrix half = Power(x, n/2);
    if(n % 2 == 0) return multiply(half, half);
    else return multiply(multiply(half, half), x);
}


int main(){

    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    ll n; cin >> n;
    Matrix base;
    base.a[0][0] = 1; base.a[0][1] = 1; base.a[1][0] = 1; base.a[1][1] = 0;
    Matrix res = Power(base, n);
    cout << res.a[0][1];


    return 0;
}
